APP_ENV=development
APP_NAME=ai-seller-ecosystem-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PORT=8000
DATABASE_URL=postgresql+psycopg://app:change-me-local-only@postgres:5432/ai_seller
REDIS_URL=redis://redis:6379/0

# Local development only. Use a managed secret store in cloud environments.
APP_SECRET_KEY=replace-with-long-random-local-secret
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
