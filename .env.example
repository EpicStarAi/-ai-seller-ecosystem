APP_ENV=development
APP_NAME=ai-seller-ecosystem-api
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PORT=8000
DATABASE_URL=postgresql+psycopg://app_runtime:change-me-local-only@postgres:5432/ai_seller
REDIS_URL=redis://redis:6379/0

# OIDC provider configuration. All three values are required for protected API routes.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Local-only database passwords are defined in docker-compose.yml.
# Production secrets must be injected through a managed secrets store.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
